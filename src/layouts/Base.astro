---
import '../styles/global.css';
interface Props { title?: string; description?: string; greeting?: boolean; }
const { title, greeting = false, description = 'こういう人間が生息しています。— 暮らしの品々と、その物語。' } = Astro.props;
const full = title ? `${title}｜こういう人間が生息しています。` : 'こういう人間が生息しています。';
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="wrap site-head">
    <a class="site-name" href="/">こういう人間が生息しています。</a>
    <nav class="site-nav" aria-label="サイト内">
      <a href="/#museum">暮らしの博物館</a>
      <a href="/#kotoba">ことば</a>
      <a href="/album/">アルバム</a>
      <a href="/#about">このサイトについて</a>
      <a href="/#visit">一緒に過ごす</a>
    </nav>
  </header>
  {greeting && (
    <div class="wrap greeting">
      <p>こんにちは。自然のめぐみです。<br />55歳。<a href="https://shizen-megumi.pages.dev" target="_blank" rel="noopener">佐賀でヨガと英語の教室</a>をしながら、好きなコト、モノに囲まれて人生をなるだけ楽しみながら生きてます。</p>
      <p>それは自分のことを知り、自分を大事にするため。<br />私の好きなモノ、コトを覗いてみませんか？</p>
      <p><a href="/#about">このサイトについて →</a></p>
    </div>
  )}
  <slot />
  <footer class="site-foot">自然のめぐみ・セルフケア by 自然の英語工房</footer>
</body>
</html>
