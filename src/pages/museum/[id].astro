---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Scene from '../../components/Scene.astro';
import { dateLabel } from '../../lib';
export async function getStaticPaths() {
  const scenes = await getCollection('scenes');
  return scenes.map((scene) => ({ params: { id: scene.id }, props: { scene } }));
}
const { scene } = Astro.props;
const { Content } = await render(scene);
const d = scene.data;
---
<Base title={d.title}>
  <main class="wrap split" style="padding-top:40px;padding-bottom:88px">
    <div class="left"><Scene scene={scene} /></div>
    <div class="right">
      <p class="label">{[dateLabel(d.date), ...d.tags].join(' ・ ')}</p>
      <h1 class="hand" style="margin:0 0 28px;font-size:32px;line-height:1.5">{d.title}</h1>
      <div class="prose"><Content /></div>
      <p style="font-size:14px;color:var(--sub)">写真の中の丸を押すと、その品物のひとことが読めます。</p>
      {d.extraPhotos.map((p) => <img src={p.src} alt={p.alt} loading="lazy" style="width:140px;height:180px;object-fit:cover;border-radius:3px;margin-top:24px" />)}
      <p style="margin-top:40px;font-size:14px"><a href="/#museum" style="color:var(--ink);text-decoration:none">← 博物館の入り口へ</a></p>
    </div>
  </main>
</Base>
