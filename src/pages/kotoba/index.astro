---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { dateKey, dateLabel } from '../../lib';
const sceneIds = new Set((await getCollection('scenes')).map((s) => s.id));
const kotoba = (await getCollection('cards', (c) => c.data.kind === 'ことば')).sort((a, b) => dateKey(b.data.date) - dateKey(a.data.date));
const essays = (await getCollection('cards', (c) => c.data.kind === 'エッセイ' && c.data.page)).sort((a, b) => dateKey(b.data.date) - dateKey(a.data.date));
const link = (id: string) => (sceneIds.has(id) ? `/museum/${id}/` : `/stories/${id}/`);
---
<Base title="ことば・エッセイ">
  <main>
    <div class="wrap" style="padding-top:48px">
      <h1 class="hand" style="margin:0 0 8px;font-size:32px">ことば・エッセイ</h1>
    </div>

    <nav class="subnav wrap" aria-label="ことば・エッセイの中のメニュー">
      <a href="#essay">エッセイ</a><span aria-hidden="true">｜</span><a href="#kotoba">ことば</a>
    </nav>

    <section id="essay" class="narrow" style="padding-top:40px;padding-bottom:72px">
      <p class="label" style="margin-bottom:16px;text-align:center">エッセイ</p>
      {essays.map((e) => (
<a href={`/stories/${e.id}/`} class="essay-item">
          {e.data.photo && <img src={e.data.photo} alt="" loading="lazy" />}
          <span class="essay-text">
            <span class="hand" style="display:block;font-size:21px;line-height:1.6">{e.data.title}</span>
            <span style="display:block;font-size:14px;color:var(--sub);margin-top:4px">{e.data.hitokoto[0]}</span>
            <span style="display:block;font-size:13px;color:var(--mute)">{dateLabel(e.data.date)}</span>
          </span>
        </a>
      ))}
    </section>
    <section id="kotoba" style="background:var(--bg2)">
      <p class="label" style="margin:0;padding-top:64px;text-align:center">ことば</p>
      {kotoba.map((k) => (
        <div class="narrow" style="padding-top:48px;padding-bottom:48px;text-align:center">
          <p class="hand" style="margin:0;font-size:24px;line-height:2;font-weight:400">{k.data.hitokoto.map((l, n) => <>{n > 0 && <br />}{l}</>)}</p>
          {k.data.related[0] && <p style="margin:24px 0 0;font-size:14px"><a href={link(k.data.related[0])}>この言葉が生まれた日 →</a></p>}
          <p style="margin:16px 0 0;font-size:13px;color:var(--mute)">{dateLabel(k.data.date)}</p>
        </div>
      ))}
    </section>

  </main>
</Base>
